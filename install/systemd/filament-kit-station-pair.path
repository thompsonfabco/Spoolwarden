[Unit]
Description=Spoolwarden Weigh Station: a pairing the Weigh Station received, waiting to be saved as root
# The station service writes pair/request.xml into its own state folder after the owner tapped Pair on the setup
# page (reverse pairing); filament-kit-station-pair.service saves it.

[Path]
PathExists=/var/lib/filament-kit-station/pair/request.xml
Unit=filament-kit-station-pair.service

[Install]
WantedBy=multi-user.target
